                  let Module(handle) = payload
                  mbt_ffi_store32((return_area) + 4, handle)

                  ()
            }
            Err(payload1) => {
                  mbt_ffi_store8((return_area) + 0, (1))

                  let ptr = mbt_ffi_str2ptr((payload1).stage)

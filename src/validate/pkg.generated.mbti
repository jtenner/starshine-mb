// Type aliases
pub type TcResult = Result[TcState, String]

// Traits
pub trait DeclMatch {
  fn matches_decl(Self, Self, Env) -> Bool
}

pub trait Match {
  fn matches(Self, Self, Env) -> Bool
}
pub impl Match for @lib.AbsHeapType
pub impl Match for @lib.CompType
pub impl Match for @lib.DefType

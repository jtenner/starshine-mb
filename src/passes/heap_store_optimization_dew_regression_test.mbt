///|
test "heap-store-optimization folds stores across nested pure blocks" {
  // Encoded from the nested-block WAT with wasm-tools.
  let input = @binary.decode_module(
    b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x0a\x02\x5f\x01\x7f\x01\x60\x01\x7f\x01\x7f\x03\x02\x01\x01\x07\x07\x01\x03\x72\x75\x6e\x00\x00\x0a\x65\x01\x63\x01\x01\x63\x00\xfb\x01\x00\x21\x01\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x02\x40\x20\x00\x1a\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x0b\x20\x01\x20\x00\xfb\x05\x00\x00\x20\x01\xfb\x02\x00\x00\x0b\x00\x0b\x04\x6e\x61\x6d\x65\x04\x04\x01\x00\x01\x73",
  ).unwrap()
  let output = run_hot_pipeline(input, HotPipelineOptions::new(), [
    "heap-store-optimization",
  ]).unwrap()
  let @lib.Func(_, @lib.Expr(body)) = output.code_sec.unwrap().0[0]
  // Store folding is required even when an unrelated nested region lies
  // between the constructor and the write. Each subtree must be visited once.
  assert_false(
    body.contains(
      @lib.Instruction::struct_set(@lib.TypeIdx::new(0U), @lib.U32(0U)),
    ),
  )
  assert_true(output.code_sec != input.code_sec)
  ignore(@validate.validate_module(output).unwrap())
}

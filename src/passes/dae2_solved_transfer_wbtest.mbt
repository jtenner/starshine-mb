///|
test "DAE2 transfers solved liveness into empty adjacency without changing borrowed graph storage" {
  let graph = Dae2Graph::new()
  ignore(graph.locations(16))
  graph.edge(0, 1)
  graph.edge(1, 2)
  graph.edge(4, 5)
  graph.edge(5, 4)
  graph.observe(0)
  graph.solve()
  let edges = graph.edges.copy()
  let next = graph.next_edge.copy()
  let first = graph.first_edge.copy()
  let last = graph.last_edge.copy()
  let used = graph.used.copy()
  let solved = graph.for_solved_rewrite()
  assert_true(physical_equal(solved.used, graph.used))
  assert_eq(solved.used, used)
  assert_true(solved.used[0] && solved.used[1] && solved.used[2])
  assert_false(solved.used[4] || solved.used[5])
  assert_eq(solved.edges.capacity(), 0)
  assert_eq(solved.next_edge.capacity(), 0)
  assert_eq(solved.first_edge.capacity(), 0)
  assert_eq(solved.last_edge.capacity(), 0)
  assert_eq(solved.work.capacity(), 0)
  assert_eq(graph.edges, edges)
  assert_eq(graph.next_edge, next)
  assert_eq(graph.first_edge, first)
  assert_eq(graph.last_edge, last)
}

///|
fn binaryen133_tail_fixture(bytes : Bytes) -> @lib.Module raise {
  let input = @binary.decode_module(bytes).unwrap()
  assert_true(@validate.validate_module(input).is_ok())
  let output = run_hot_pipeline(input, HotPipelineOptions::new(), ["tail-call"]).unwrap()
  assert_true(@validate.validate_module(output).is_ok())
  output
}

///|
test "Binaryen 133 tail-call converts table64 indirect calls" {
  let output = binaryen133_tail_fixture(Bytes::from_array([
    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x04, 0x01, 0x60, 0x00,
    0x00, 0x03, 0x03, 0x02, 0x00, 0x00, 0x04, 0x05, 0x01, 0x70, 0x05, 0x02, 0x02,
    0x09, 0x0b, 0x01, 0x06, 0x00, 0x42, 0x01, 0x0b, 0x70, 0x01, 0xd2, 0x00, 0x0b,
    0x0a, 0x0d, 0x02, 0x03, 0x00, 0x01, 0x0b, 0x07, 0x00, 0x42, 0x01, 0x11, 0x00,
    0x00, 0x0b,
  ]))
  assert_eq(binaryen133_shared_opcode_count(output, @lib.Instruction::return_call_indirect(@lib.TypeIdx::new(0U), @lib.TableIdx::new(0U))), 1)
}

///|
test "Binaryen 133 tail-call converts calls from a legacy catch handler" {
  let output = binaryen133_tail_fixture(Bytes::from_array([
    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x07, 0x02, 0x60, 0x00,
    0x00, 0x60, 0x00, 0x00, 0x02, 0x1b, 0x02, 0x03, 0x65, 0x6e, 0x76, 0x06, 0x64,
    0x69, 0x65, 0x2e, 0x65, 0x68, 0x00, 0x00, 0x03, 0x65, 0x6e, 0x76, 0x06, 0x64,
    0x69, 0x65, 0x2e, 0x65, 0x68, 0x00, 0x00, 0x03, 0x02, 0x01, 0x00, 0x0d, 0x03,
    0x01, 0x00, 0x01, 0x07, 0x07, 0x01, 0x03, 0x72, 0x75, 0x6e, 0x00, 0x02, 0x0a,
    0x0d, 0x01, 0x0b, 0x00, 0x06, 0x40, 0x08, 0x00, 0x07, 0x00, 0x10, 0x01, 0x0b,
    0x0b,
  ]))
  assert_eq(binaryen133_shared_opcode_count(output, @lib.Instruction::return_call(@lib.FuncIdx::new(1U))), 1)
}

///|
test "Binaryen 133 tail-call converts indirect calls from a legacy catch-all" {
  let output = binaryen133_tail_fixture(Bytes::from_array([
    0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x04, 0x01, 0x60, 0x00,
    0x00, 0x03, 0x03, 0x02, 0x00, 0x00, 0x04, 0x05, 0x01, 0x70, 0x01, 0x01, 0x01,
    0x0d, 0x03, 0x01, 0x00, 0x00, 0x09, 0x07, 0x01, 0x00, 0x41, 0x00, 0x0b, 0x01,
    0x00, 0x0a, 0x13, 0x02, 0x03, 0x00, 0x01, 0x0b, 0x0d, 0x00, 0x06, 0x40, 0x08,
    0x00, 0x19, 0x41, 0x00, 0x11, 0x00, 0x00, 0x0b, 0x0b,
  ]))
  assert_eq(binaryen133_shared_opcode_count(output, @lib.Instruction::return_call_indirect(@lib.TypeIdx::new(0U), @lib.TableIdx::new(0U))), 1)
}

///|
test "Binaryen 133 tail-call retains calls whose throws reach a local handler" {
  let input = pass_test_module_from_wat(
    "(module (import \"env\" \"work\" (func $work)) (tag $e) (func (export \"run\") (call $work)))",
  )
  let call = @lib.Expr::new([@lib.Instruction::call(@lib.FuncIdx::new(0U))])
  let catcher = @lib.LegacyCatch::tagged(@lib.TagIdx::new(0U), @lib.Expr::new([]))
  for nested in [false, true] {
    let body = if nested {
      @lib.Expr::new([@lib.Instruction::try_(
        @lib.BlockType::void_(),
        @lib.Expr::new([@lib.Instruction::throw_(@lib.TagIdx::new(0U))]),
        [@lib.LegacyCatch::all(call)],
      )])
    } else { call }
    let input = input.with_code_sec(@lib.CodeSec::new([
      @lib.Func::new(@lib.Locals::empty(), @lib.Expr::new([
        @lib.Instruction::try_(@lib.BlockType::void_(), body, [catcher]),
      ])),
    ]))
    assert_true(@validate.validate_module(input).is_ok())
    let output = run_hot_pipeline(input, HotPipelineOptions::new(), ["tail-call"]).unwrap()
    assert_true(@validate.validate_module(output).is_ok())
    assert_eq(binaryen133_shared_opcode_count(output, @lib.Instruction::call(@lib.FuncIdx::new(0U))), 1)
    assert_eq(binaryen133_shared_opcode_count(output, @lib.Instruction::return_call(@lib.FuncIdx::new(0U))), 0)
  }
}

///|
test "rse respects the static receiver type after a widening cast" {
  let input = @binary.decode_module(
    b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x1a\x04\x50\x00\x5f\x01\x7f\x00\x50\x01\x00\x5f\x02\x7f\x00\x7f\x00\x60\x01\x64\x01\x01\x7f\x60\x00\x01\x7f\x03\x03\x02\x02\x03\x07\x07\x01\x03\x72\x75\x6e\x00\x01\x0a\x25\x02\x17\x01\x01\x63\x00\x20\x00\x21\x01\x20\x00\x22\x01\x1a\x20\x00\xfb\x16\x00\xfb\x02\x00\x00\x0b\x0b\x00\x41\x2a\x41\x07\xfb\x00\x01\x10\x00\x0b\x00\x1f\x04\x6e\x61\x6d\x65\x01\x08\x01\x00\x05\x66\x69\x65\x6c\x64\x04\x0e\x02\x00\x04\x62\x61\x73\x65\x01\x05\x63\x68\x69\x6c\x64",
  ).unwrap()
  let output = run_hot_pipeline(input, HotPipelineOptions::new(), [
    "redundant-set-elimination",
  ]).unwrap()
  ignore(@validate.validate_module(output).unwrap())
  let @lib.Func(_, @lib.Expr(body)) = output.code_sec.unwrap().0[0]
  assert_true(
    body.contains(
      @lib.Instruction::struct_get(@lib.TypeIdx::new(0U), @lib.U32(0U)),
    ),
    msg=body.to_string(),
  )
  assert_false(
    body.contains(@lib.Instruction::local_tee(@lib.LocalIdx::new(1U))),
    msg="same-value tee removal must remain active",
  )
}

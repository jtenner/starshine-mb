///|
// These fixtures replace pre-liveness fresh-local/copy expectations. Merge
// participants stay canonical under the no-merge contract. Keep exact encoded
// branch types, loop inputs, local traffic and reference types checked here;
// execution cases live in tests/optimizer/regressions/ssa-canonical-merges.
fn ssa_test_assert_canonical_merge_encoding(
  input : @lib.Module,
  rewritten_fixture : Int?,
) -> Unit raise {
  let optimized = match
    run_hot_pipeline(input, HotPipelineOptions::new(), ["ssa-nomerge"]) {
    Ok(mod_) => mod_
    Err(err) => fail("canonical merge pipeline failed: \{err}")
  }
  match @validate.validate_module(optimized) {
    Ok(_) => ()
    Err(err) => fail("canonical merge output must validate: \{err}")
  }
  let expected = match rewritten_fixture {
    None =>
      match @binary.encode_module(input) {
        Ok(bytes) => bytes
        Err(err) => fail("cannot encode canonical input: \{err}")
      }
    Some(id) => ssa_test_bytes_from_ints(ssa_test_canonical_merge_fixture(id))
  }
  let actual = match @binary.encode_module(optimized) {
    Ok(bytes) => bytes
    Err(err) => fail("cannot encode canonical output: \{err}")
  }
  @debug.assert_eq(actual, expected)
}


///|
test "flatten keeps SIMD constants nullary after a branch-table merge" {
  let input = @binary.decode_module(
    b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x18\x04\x5e\x7b\x01\x5f\x03\x64\x00\x00\x7f\x00\x7f\x00\x60\x03\x6d\x7f\x6d\x01\x7f\x60\x00\x01\x7f\x03\x03\x02\x02\x03\x07\x07\x01\x03\x72\x75\x6e\x00\x01\x0a\x44\x02\x04\x00\x20\x01\x0b\x3d\x00\x02\x40\x02\x40\x02\x40\x02\x40\x41\x00\x0e\x02\x00\x01\x02\x0b\x0c\x02\x0b\x0c\x01\x0b\x00\x0b\xd0\x6d\x41\x01\xfd\x0c\x01\x00\x00\x00\x02\x00\x00\x00\x03\x00\x00\x00\x04\x00\x00\x00\xfb\x08\x00\x01\x41\x00\x41\x07\xfb\x00\x01\x10\x00\x0b\x00\x17\x04\x6e\x61\x6d\x65\x01\x07\x01\x00\x04\x73\x69\x6e\x6b\x04\x07\x02\x00\x01\x61\x01\x01\x73",
  ).unwrap()
  let output = run_hot_pipeline(input, HotPipelineOptions::new(), ["flatten"]).unwrap()
  ignore(@validate.validate_module(output).unwrap())
  let @lib.Func(locals, @lib.Expr(body)) = output.code_sec.unwrap().0[1]
  assert_true(
    locals.length() > 0,
    msg="the nested allocation must be flattened",
  )
  let vectors = body.filter(fn(instr) {
    match instr {
      @lib.Instruction::V128Const(
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _,
        _
      ) => true
      _ => false
    }
  })
  @debug.assert_eq(vectors.length(), 1)
}

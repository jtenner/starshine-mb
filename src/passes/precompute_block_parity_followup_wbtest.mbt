///|
test "parity followup precompute removes branchless value block shell" {
  let input = @binary.decode_module(
    Bytes::from_array([
      0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x05, 0x01, 0x60, 0x01,
      0x7f, 0x00, 0x03, 0x03, 0x02, 0x00, 0x00, 0x0a, 0x71, 0x02, 0x02, 0x00, 0x0b,
      0x6c, 0x01, 0x06, 0x7f, 0x20, 0x00, 0x04, 0x40, 0x41, 0x0a, 0x21, 0x01, 0x05,
      0x41, 0x0a, 0x21, 0x01, 0x0b, 0x20, 0x01, 0x10, 0x00, 0x20, 0x00, 0x04, 0x40,
      0x41, 0x0a, 0x21, 0x02, 0x05, 0x41, 0x14, 0x21, 0x02, 0x0b, 0x20, 0x02, 0x10,
      0x00, 0x20, 0x03, 0x10, 0x00, 0x41, 0x07, 0x22, 0x04, 0x1a, 0x20, 0x04, 0x10,
      0x00, 0x02, 0x7f, 0x41, 0x07, 0x22, 0x05, 0x1a, 0x41, 0x00, 0x0b, 0x21, 0x06,
      0x20, 0x05, 0x10, 0x00, 0x41, 0x0a, 0x21, 0x01, 0x20, 0x00, 0x04, 0x40, 0x20,
      0x01, 0x41, 0x01, 0x6a, 0x21, 0x02, 0x05, 0x20, 0x01, 0x41, 0x01, 0x6a, 0x21,
      0x02, 0x0b, 0x20, 0x02, 0x41, 0x0a, 0x6a, 0x21, 0x02, 0x20, 0x02, 0x10, 0x00,
      0x20, 0x00, 0x10, 0x00, 0x0b,
    ]),
  ).unwrap()
  for
    output in [
      run_hot_pipeline(input, HotPipelineOptions::new(), ["precompute"]).unwrap(),
      run_hot_pipeline_apply_hot_pass_stack(
        input,
        [pass_registry_lookup("precompute").unwrap()],
        HotPipelineOptions::new(),
      ).unwrap(),
      run_hot_pipeline_apply_hot_pass_stack_to_touched(
        input,
        [precompute_descriptor()],
        Array::make(input.code_sec.unwrap().0.length(), true),
        HotPipelineOptions::new(),
      ).unwrap(),
    ] {
    assert_true(@validate.validate_module(output) is Ok(_))
    for func in output.code_sec.unwrap().0 {
      let @lib.Func(_, @lib.Expr(body)) = func
      assert_false(body.any(fn(instr) { instr is @lib.Block(_, _) }))
    }
  }
}

///|
test "parity followup precompute-propagate removes branchless value block shell" {
  let input = @binary.decode_module(
    Bytes::from_array([
      0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x05, 0x01, 0x60, 0x00,
      0x01, 0x7f, 0x03, 0x02, 0x01, 0x00, 0x0a, 0x0d, 0x01, 0x0b, 0x01, 0x01, 0x7f,
      0x41, 0x01, 0x22, 0x00, 0x41, 0x02, 0x6a, 0x0b,
    ]),
  ).unwrap()
  for
    output in [
      run_hot_pipeline(input, HotPipelineOptions::new(), [
        "precompute-propagate",
      ]).unwrap(),
      run_hot_pipeline_apply_hot_pass_stack(
        input,
        [pass_registry_lookup("precompute-propagate").unwrap()],
        HotPipelineOptions::new(),
      ).unwrap(),
      run_hot_pipeline_apply_hot_pass_stack_to_touched(
        input,
        [precompute_propagate_descriptor()],
        Array::make(input.code_sec.unwrap().0.length(), true),
        HotPipelineOptions::new(),
      ).unwrap(),
    ] {
    assert_true(@validate.validate_module(output) is Ok(_))
    for func in output.code_sec.unwrap().0 {
      let @lib.Func(_, @lib.Expr(body)) = func
      assert_false(body.any(fn(instr) { instr is @lib.Block(_, _) }))
    }
  }
}

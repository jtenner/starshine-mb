///|
fn precompute_unused_gc_type_parity_fixture() -> @lib.Module {
  @binary.decode_module(
    Bytes::from_array([
      0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x13, 0x05, 0x5e, 0x7f,
      0x00, 0x5e, 0x78, 0x00, 0x5f, 0x01, 0x7f, 0x00, 0x5f, 0x01, 0x78, 0x00, 0x60,
      0x00, 0x01, 0x7f, 0x03, 0x0e, 0x0d, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04,
      0x04, 0x04, 0x04, 0x04, 0x04, 0x04, 0x0a, 0xb4, 0x01, 0x0d, 0x0d, 0x00, 0x41,
      0x2a, 0xfb, 0x08, 0x00, 0x01, 0x41, 0x00, 0xfb, 0x0b, 0x00, 0x0b, 0x09, 0x00,
      0x41, 0x07, 0xfb, 0x07, 0x00, 0xfb, 0x0f, 0x0b, 0x0e, 0x00, 0x41, 0xff, 0x01,
      0xfb, 0x08, 0x01, 0x01, 0x41, 0x00, 0xfb, 0x0c, 0x01, 0x0b, 0x09, 0x00, 0xfb,
      0x01, 0x02, 0xfb, 0x02, 0x02, 0x00, 0x0b, 0x0c, 0x00, 0x41, 0xff, 0x01, 0xfb,
      0x00, 0x03, 0xfb, 0x03, 0x03, 0x00, 0x0b, 0x0e, 0x00, 0x41, 0x07, 0x41, 0x03,
      0xfb, 0x06, 0x00, 0x41, 0x02, 0xfb, 0x0b, 0x00, 0x0b, 0x0e, 0x00, 0x41, 0x07,
      0x41, 0x7f, 0xfb, 0x06, 0x00, 0x41, 0x00, 0xfb, 0x0b, 0x00, 0x0b, 0x0b, 0x00,
      0x41, 0x07, 0x41, 0x7f, 0xfb, 0x06, 0x00, 0xfb, 0x0f, 0x0b, 0x0c, 0x00, 0x41,
      0x7f, 0xfb, 0x07, 0x00, 0x41, 0x00, 0xfb, 0x0b, 0x00, 0x0b, 0x0d, 0x00, 0x41,
      0x07, 0xfb, 0x08, 0x00, 0x01, 0x41, 0x01, 0xfb, 0x0b, 0x00, 0x0b, 0x0e, 0x00,
      0x41, 0x07, 0x41, 0xa9, 0xd5, 0xaa, 0x15, 0xfb, 0x06, 0x00, 0xfb, 0x0f, 0x0b,
      0x0e, 0x00, 0x41, 0x07, 0x41, 0xaa, 0xd5, 0xaa, 0x15, 0xfb, 0x06, 0x00, 0xfb,
      0x0f, 0x0b, 0x11, 0x00, 0x41, 0x07, 0x41, 0xaa, 0xd5, 0xaa, 0x15, 0xfb, 0x06,
      0x00, 0x41, 0x00, 0xfb, 0x0b, 0x00, 0x0b,
    ]),
  ).unwrap()
}

///|
test "parity followup precompute prunes GC types made unused by folding" {
  let input = precompute_unused_gc_type_parity_fixture()
  let output = run_hot_pipeline(input, HotPipelineOptions::new(), ["precompute"]).unwrap()
  assert_true(@validate.validate_module(output) is Ok(_))
  // Only the still-trapping i32 array operations and result signature remain.
  assert_eq(output.type_sec.unwrap().0.length(), 2)
  assert_eq(@binary.encode_module(output).unwrap().length(), 162)
  for type_idx in output.func_sec.unwrap().0 {
    assert_eq(type_idx, @lib.TypeIdx::new(1U))
  }
}

///|
test "parity followup precompute-propagate prunes GC types made unused by folding" {
  let input = precompute_unused_gc_type_parity_fixture()
  let output = run_hot_pipeline(input, HotPipelineOptions::new(), [
    "precompute-propagate",
  ]).unwrap()
  assert_true(@validate.validate_module(output) is Ok(_))
  // Only the still-trapping i32 array operations and result signature remain.
  assert_eq(output.type_sec.unwrap().0.length(), 2)
  assert_eq(@binary.encode_module(output).unwrap().length(), 162)
  for type_idx in output.func_sec.unwrap().0 {
    assert_eq(type_idx, @lib.TypeIdx::new(1U))
  }
}

///|
test "Precompute type cleanup intentionally excludes unhandled nested proposals and unchanged code" {
  let input = precompute_unused_gc_type_parity_fixture()
  assert_eq(
    @binary.encode_module(precompute_cleanup_unused_gc_types(input, input)).unwrap(),
    @binary.encode_module(input).unwrap(),
  )
  // Admission, not execution: the shared remapper does not support StructWait.
  assert_false(
    precompute_type_cleanup_instrs_supported([
      @lib.Instruction::block(
        @lib.BlockType::void_(),
        @lib.Expr::new([
          @lib.Instruction::struct_wait(@lib.TypeIdx::new(0U), @lib.U32(0U)),
        ]),
      ),
    ]),
  )
  let grouped = input.with_type_sec(
    @lib.TypeSec::new([
      @lib.RecType::group([@lib.SubType::comp_type(@lib.CompType::struct_([]))]),
    ]),
  )
  assert_false(precompute_type_cleanup_supported(grouped))
}

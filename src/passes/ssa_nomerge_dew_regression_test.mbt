///|
test "ssa-nomerge preserves a closure copy in a nested loop predicate" {
  // Encoded from tests/fixtures/ssa-nomerge/closure-loop.wat with wasm-tools.
  // The WAT parser does not yet accept the fixture's flat ref.cast spelling.
  let bytes = b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x28\x07\x5f\x01\x7f\x00\x60\x01\x7f\x01\x7f\x60\x02\x6d\x7f\x01\x7f\x5f\x01\x70\x00\x60\x01\x64\x00\x01\x7f\x60\x02\x64\x00\x7f\x01\x7f\x60\x02\x64\x00\x6d\x01\x7f\x03\x06\x05\x04\x05\x01\x06\x01\x07\x07\x01\x03\x72\x75\x6e\x00\x04\x09\x05\x01\x03\x00\x01\x02\x0a\xd1\x01\x05\x08\x00\x20\x00\xfb\x02\x00\x00\x0b\x04\x00\x20\x01\x0b\x04\x00\x41\x01\x0b\xac\x01\x03\x02\x7f\x01\x6d\x02\x7f\x20\x00\xfb\x16\x00\x10\x00\x21\x02\x41\x00\x21\x05\x02\x40\x03\x40\x02\x40\x41\x01\x04\x40\x20\x05\x21\x03\x20\x03\x20\x02\x49\x04\x40\x20\x03\x20\x00\xfb\x16\x00\x10\x00\x49\x04\x7f\x20\x01\x21\x04\x20\x04\xfb\x16\x03\xfb\x02\x03\x00\xfb\x14\x01\x04\x7f\x20\x00\xfb\x16\x00\x20\x03\x10\x01\x20\x04\xfb\x16\x03\xfb\x02\x03\x00\xfb\x16\x01\x14\x01\x05\x20\x04\x20\x00\xfb\x16\x00\x20\x03\x10\x01\x20\x04\xfb\x16\x03\xfb\x02\x03\x00\xfb\x16\x02\x14\x02\x0b\x45\x05\x41\x00\x0b\x04\x40\x41\x00\x21\x06\x0c\x05\x05\x20\x03\x41\x01\x6a\x21\x05\x0c\x04\x0b\x00\x0c\x02\x0b\x0b\x41\x01\x04\x40\x41\x01\x21\x06\x0c\x03\x0c\x01\x0b\x00\x0b\x00\x0b\x00\x0b\x20\x06\x0b\x0e\x00\x20\x00\xfb\x00\x00\xd2\x02\xfb\x00\x03\x10\x03\x0b\x00\x46\x04\x6e\x61\x6d\x65\x01\x1e\x04\x00\x06\x6c\x65\x6e\x67\x74\x68\x01\x03\x67\x65\x74\x02\x09\x70\x72\x65\x64\x69\x63\x61\x74\x65\x03\x03\x72\x75\x6e\x04\x1f\x04\x00\x05\x61\x72\x72\x61\x79\x01\x05\x70\x6c\x61\x69\x6e\x02\x05\x62\x6f\x75\x6e\x64\x03\x07\x63\x6c\x6f\x73\x75\x72\x65"
  let input = match @binary.decode_module(bytes) {
    Ok(mod_) => mod_
    Err(err) => fail("cannot decode closure-loop fixture: \{err}")
  }
  let optimized = match
    run_hot_pipeline(input, HotPipelineOptions::new(), ["ssa-nomerge"]) {
    Ok(mod_) => mod_
    Err(err) => fail("nested loop closure optimization failed: \{err}")
  }
  match @validate.validate_module(optimized) {
    Ok(_) => ()
    Err(err) => fail("nested loop closure is invalid: \{err}")
  }
  let (_, body) = ssa_test_defined_func(optimized, 3)
  let (_, original_body) = ssa_test_defined_func(input, 3)
  assert_false(body == original_body, msg="the loop must still be optimized")
  assert_false(
    ssa_test_instrs_have_ref_null_type(
      body,
      @lib.RefType::new(true, @lib.HeapType::abs(@lib.AbsHeapType::eq())),
    ),
    msg="a copied live closure must not become the null entry value",
  )
}

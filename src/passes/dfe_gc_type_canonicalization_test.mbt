///|
fn dfe_gc_transitive_test_fixture() -> @lib.Module {
  @binary.decode_module(
    b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x21\x07\x5f\x01\x7f\x00\x5f\x01\x7f\x00\x5e\x63\x00\x01\x5e\x63\x01\x01\x60\x01\x63\x02\x01\x7f\x60\x01\x63\x03\x01\x7f\x60\x00\x01\x7f\x03\x04\x03\x04\x05\x06\x07\x07\x01\x03\x72\x75\x6e\x00\x02\x0a\x37\x03\x0d\x00\x20\x00\x41\x00\xfb\x0b\x02\xfb\x02\x00\x00\x0b\x0d\x00\x20\x00\x41\x00\xfb\x0b\x03\xfb\x02\x01\x00\x0b\x19\x00\x41\x07\xfb\x00\x00\xfb\x08\x02\x01\x10\x00\x41\x0b\xfb\x00\x01\xfb\x08\x03\x01\x10\x01\x6a\x0b\x00\x34\x04\x6e\x61\x6d\x65\x01\x0e\x02\x00\x04\x6c\x65\x66\x74\x01\x05\x72\x69\x67\x68\x74\x04\x1d\x06\x00\x01\x61\x01\x01\x62\x02\x05\x61\x72\x72\x5f\x61\x03\x05\x61\x72\x72\x5f\x62\x04\x02\x66\x61\x05\x02\x66\x62",
  ).unwrap()
}

///|
test "DFE canonicalizes transitive GC types before merging private bodies" {
  // Binary-decoded fixture: local WAT parser lacks array.get.
  // (module
  //  (type $a (struct (field i32)))
  //  (type $b (struct (field i32)))
  //  (type $arr_a (array (mut (ref null $a))))
  //  (type $arr_b (array (mut (ref null $b))))
  //  (type $fa (func (param (ref null $arr_a)) (result i32)))
  //  (type $fb (func (param (ref null $arr_b)) (result i32)))
  //  (func $left (type $fa) (param (ref null $arr_a)) (result i32)
  //    local.get 0 i32.const 0 array.get $arr_a struct.get $a 0)
  //  (func $right (type $fb) (param (ref null $arr_b)) (result i32)
  //    local.get 0 i32.const 0 array.get $arr_b struct.get $b 0)
  //  (func (export "run") (result i32)
  //    i32.const 7 struct.new $a array.new_fixed $arr_a 1 call $left
  //    i32.const 11 struct.new $b array.new_fixed $arr_b 1 call $right i32.add))
  let input = dfe_gc_transitive_test_fixture()
  assert_true(@validate.validate_module(input) is Ok(_))
  let before = @binary.encode_module(input).unwrap()
  let output = run_hot_pipeline(input, HotPipelineOptions::new(), [
    "duplicate-function-elimination",
  ]).unwrap()
  @debug.assert_eq(output.func_sec.unwrap().0.length(), 2)
  @debug.assert_eq(output.type_sec.unwrap().0.length(), 4)
  @debug.assert_eq(output.export_sec.unwrap().0.length(), 1)
  assert_true(@validate.validate_module(output) is Ok(_))
  assert_true(@binary.encode_module(output).unwrap().length() < before.length())
  @debug.assert_eq(@binary.encode_module(input).unwrap(), before)
}

///|
test "DFE mixed GC aliases remap whole groups and protected imported exported interfaces" {
  let input = @binary.decode_module(
    b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x36\x09\x5f\x01\x7f\x01\x5f\x01\x7f\x01\x4e\x02\x5f\x01\x63\x01\x00\x5f\x01\x63\x02\x00\x60\x01\x63\x03\x01\x7f\x60\x01\x63\x01\x01\x7f\x60\x01\x7f\x01\x64\x03\x60\x02\x63\x03\x7f\x00\x60\x01\x63\x03\x00\x60\x00\x01\x7f\x02\x0f\x01\x04\x68\x6f\x73\x74\x06\x61\x63\x63\x65\x70\x74\x00\x05\x03\x08\x07\x04\x04\x06\x07\x08\x09\x09\x06\x07\x01\x63\x03\x01\xd0\x03\x0b\x07\x41\x07\x04\x72\x65\x61\x64\x00\x01\x09\x72\x65\x61\x64\x41\x67\x61\x69\x6e\x00\x02\x04\x6d\x61\x6b\x65\x00\x03\x05\x77\x72\x69\x74\x65\x00\x04\x05\x73\x74\x61\x73\x68\x00\x05\x08\x72\x65\x61\x64\x53\x6c\x6f\x74\x00\x06\x08\x68\x6f\x73\x74\x43\x61\x6c\x6c\x00\x07\x0a\x66\x07\x10\x00\x20\x00\xfb\x02\x03\x00\xfb\x02\x02\x00\xfb\x02\x01\x00\x0b\x10\x00\x20\x00\xfb\x02\x03\x00\xfb\x02\x02\x00\xfb\x02\x01\x00\x0b\x0d\x00\x20\x00\xfb\x00\x01\xfb\x00\x02\xfb\x00\x03\x0b\x12\x00\x20\x00\xfb\x02\x03\x00\xfb\x02\x02\x00\x20\x01\xfb\x05\x01\x00\x0b\x09\x01\x01\x63\x01\x20\x00\x24\x00\x0b\x10\x00\x23\x00\xfb\x02\x03\x00\xfb\x02\x02\x00\xfb\x02\x01\x00\x0b\x06\x00\xd0\x01\x10\x00\x0b\x00\x3d\x04\x6e\x61\x6d\x65\x01\x09\x01\x00\x06\x61\x63\x63\x65\x70\x74\x04\x22\x05\x00\x04\x62\x61\x73\x65\x01\x05\x61\x6c\x69\x61\x73\x02\x04\x6e\x6f\x64\x65\x03\x04\x74\x61\x69\x6c\x04\x06\x72\x65\x61\x64\x65\x72\x07\x07\x01\x00\x04\x73\x6c\x6f\x74",
  ).unwrap()
  let expected = @binary.decode_module(
    b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x32\x08\x5f\x01\x7f\x01\x4e\x02\x5f\x01\x63\x00\x00\x5f\x01\x63\x01\x00\x60\x01\x63\x02\x01\x7f\x60\x01\x63\x00\x01\x7f\x60\x01\x7f\x01\x64\x02\x60\x02\x63\x02\x7f\x00\x60\x01\x63\x02\x00\x60\x00\x01\x7f\x02\x0f\x01\x04\x68\x6f\x73\x74\x06\x61\x63\x63\x65\x70\x74\x00\x04\x03\x08\x07\x03\x03\x05\x06\x07\x08\x08\x06\x07\x01\x63\x02\x01\xd0\x02\x0b\x07\x41\x07\x04\x72\x65\x61\x64\x00\x01\x09\x72\x65\x61\x64\x41\x67\x61\x69\x6e\x00\x02\x04\x6d\x61\x6b\x65\x00\x03\x05\x77\x72\x69\x74\x65\x00\x04\x05\x73\x74\x61\x73\x68\x00\x05\x08\x72\x65\x61\x64\x53\x6c\x6f\x74\x00\x06\x08\x68\x6f\x73\x74\x43\x61\x6c\x6c\x00\x07\x0a\x66\x07\x10\x00\x20\x00\xfb\x02\x02\x00\xfb\x02\x01\x00\xfb\x02\x00\x00\x0b\x10\x00\x20\x00\xfb\x02\x02\x00\xfb\x02\x01\x00\xfb\x02\x00\x00\x0b\x0d\x00\x20\x00\xfb\x00\x00\xfb\x00\x01\xfb\x00\x02\x0b\x12\x00\x20\x00\xfb\x02\x02\x00\xfb\x02\x01\x00\x20\x01\xfb\x05\x00\x00\x0b\x09\x01\x01\x63\x00\x20\x00\x24\x00\x0b\x10\x00\x23\x00\xfb\x02\x02\x00\xfb\x02\x01\x00\xfb\x02\x00\x00\x0b\x06\x00\xd0\x00\x10\x00\x0b\x00\x36\x04\x6e\x61\x6d\x65\x01\x09\x01\x00\x06\x61\x63\x63\x65\x70\x74\x04\x1b\x04\x00\x04\x62\x61\x73\x65\x01\x04\x6e\x6f\x64\x65\x02\x04\x74\x61\x69\x6c\x03\x06\x72\x65\x61\x64\x65\x72\x07\x07\x01\x00\x04\x73\x6c\x6f\x74",
  ).unwrap()
  assert_true(@validate.validate_module(input) is Ok(_))
  let before = @binary.encode_module(input).unwrap()
  let output = run_hot_pipeline(input, HotPipelineOptions::new(), [
    "duplicate-function-elimination",
  ]).unwrap()
  @debug.assert_eq(output.type_sec, expected.type_sec)
  @debug.assert_eq(output.func_sec, expected.func_sec)
  @debug.assert_eq(output.import_sec, expected.import_sec)
  @debug.assert_eq(output.global_sec, expected.global_sec)
  @debug.assert_eq(output.code_sec, expected.code_sec)
  @debug.assert_eq(output.export_sec, input.export_sec)
  assert_true(@validate.validate_module(output) is Ok(_))
  assert_true(@binary.encode_module(output).unwrap().length() < before.length())
  @debug.assert_eq(@binary.encode_module(input).unwrap(), before)
}

///|
test "DFE canonicalizes equivalent nonfinal bases and final subtype chains" {
  let input = @binary.decode_module(
    b"\x00\x61\x73\x6d\x01\x00\x00\x00\x01\x39\x08\x50\x00\x5f\x01\x7f\x00\x50\x00\x5f\x01\x7f\x00\x4f\x01\x00\x5f\x02\x7f\x00\x63\x00\x00\x4f\x01\x01\x5f\x02\x7f\x00\x63\x01\x00\x60\x01\x7f\x01\x64\x02\x60\x01\x7f\x01\x64\x03\x60\x01\x63\x00\x01\x7f\x60\x01\x63\x01\x01\x7f\x03\x05\x04\x04\x05\x06\x07\x07\x21\x04\x05\x6d\x61\x6b\x65\x41\x00\x00\x05\x6d\x61\x6b\x65\x42\x00\x01\x05\x72\x65\x61\x64\x41\x00\x02\x05\x72\x65\x61\x64\x42\x00\x03\x0a\x27\x04\x09\x00\x20\x00\xd0\x00\xfb\x00\x02\x0b\x09\x00\x20\x00\xd0\x01\xfb\x00\x03\x0b\x08\x00\x20\x00\xfb\x02\x00\x00\x0b\x08\x00\x20\x00\xfb\x02\x01\x00\x0b\x00\x16\x04\x6e\x61\x6d\x65\x04\x0f\x04\x00\x01\x61\x01\x01\x62\x02\x02\x63\x61\x03\x02\x63\x62",
  ).unwrap()
  assert_true(@validate.validate_module(input) is Ok(_))
  let output = run_hot_pipeline(input, HotPipelineOptions::new(), [
    "duplicate-function-elimination",
  ]).unwrap()
  @debug.assert_eq(output.type_sec.unwrap().0.length(), 4)
  // All bodies are exported, so canonicalizing signatures must retain every
  // function identity even when body/signature pairs become equal.
  @debug.assert_eq(
    output.func_sec,
    Some(
      @lib.FuncSec::new([
        @lib.TypeIdx::new(2U),
        @lib.TypeIdx::new(2U),
        @lib.TypeIdx::new(3U),
        @lib.TypeIdx::new(3U),
      ]),
    ),
  )
  @debug.assert_eq(output.export_sec, input.export_sec)
  assert_true(@validate.validate_module(output) is Ok(_))
}

///|
test "numeric O4s exposes bounded GC canonicalization through the existing preset" {
  let input = dfe_gc_transitive_test_fixture()
  let output = run_hot_pipeline(
    input,
    HotPipelineOptions::new(optimize_level=4, shrink_level=1),
    ["optimize"],
  ).unwrap()
  @debug.assert_eq(output.func_sec.unwrap().0.length(), 2)
  @debug.assert_eq(output.type_sec.unwrap().0.length(), 4)
  @debug.assert_eq(
    output.export_sec,
    Some(
      @lib.ExportSec::new([
        @lib.Export::new(
          @lib.Name::from_string("run"),
          @lib.ExternIdx::func(@lib.FuncIdx::new(1U)),
        ),
      ]),
    ),
  )
  assert_true(@validate.validate_module(output) is Ok(_))
  assert_true(
    @binary.encode_module(output).unwrap().length() <
    @binary.encode_module(input).unwrap().length(),
  )
}

///|
test "dae2 upstream regression legacy try without handlers" {
  // Binaryen version_132 test/lit/passes/dae2.wast, module 064.
  let input = match
    @binary.decode_module(
      Bytes::from_array([
        0x00, 0x61, 0x73, 0x6d, 0x01, 0x00, 0x00, 0x00, 0x01, 0x0c, 0x03, 0x60, 0x01,
        0x7f, 0x00, 0x60, 0x00, 0x00, 0x60, 0x00, 0x01, 0x7f, 0x02, 0x0b, 0x01, 0x00,
        0x00, 0x7f, 0x02, 0x00, 0x00, 0x01, 0x00, 0x00, 0x02, 0x03, 0x04, 0x03, 0x00,
        0x00, 0x00, 0x0d, 0x03, 0x01, 0x00, 0x01, 0x0a, 0x2d, 0x03, 0x08, 0x00, 0x06,
        0x7f, 0x20, 0x00, 0x0b, 0x1a, 0x0b, 0x0a, 0x00, 0x06, 0x7f, 0x10, 0x00, 0x20,
        0x00, 0x0b, 0x1a, 0x0b, 0x17, 0x00, 0x06, 0x7f, 0x41, 0x00, 0x07, 0x00, 0x20,
        0x00, 0x07, 0x00, 0x10, 0x00, 0x41, 0x01, 0x19, 0x10, 0x00, 0x41, 0x02, 0x0b,
        0x1a, 0x0b,
      ]),
    ) {
    Ok(mod_) => mod_
    Err(err) => fail("intake decode: \{err}")
  }
  for closed_world in [false, true] {
    match
      run_hot_pipeline(input, HotPipelineOptions::new(closed_world~), ["dae2"]) {
      Ok(output) =>
        match @validate.validate_module(output) {
          Ok(_) => ()
          Err(err) => fail("intake validation: \{err}")
        }
      Err(err) => fail("intake DAE2: \{err}")
    }
  }
}


///|
test "r1 f32 exact decimal boundaries round once for both signs" {
  for
    (text, expected) in [
      ("1.0000000596046448", 0x3f800001),
      ("1.0000000596046447", 0x3f800000),
      ("1.000000059604644775390625", 0x3f800000),
      ("1.000000178813934326171875", 0x3f800002),
      ("1.0000001788139343", 0x3f800001),
      ("1.0000001788139344", 0x3f800002),
      ("0.9999999701976776123046875", 0x3f800000),
      ("0.9999999701976776123046874", 0x3f7fffff),
      ("1_0.000000596046448e-1", 0x3f800001),
      (
        "0.0000000000000000000000000000000000000000000007006492321624085354618647916449580656401309709382578858785341419448955413429303007433190941810607910156249",
        0x00000000,
      ),
      (
        "0.000000000000000000000000000000000000000000000700649232162408535461864791644958065640130970938257885878534141944895541342930300743319094181060791015625",
        0x00000000,
      ),
      (
        "0.0000000000000000000000000000000000000000000007006492321624085354618647916449580656401309709382578858785341419448955413429303007433190941810607910156251",
        0x00000001,
      ),
      (
        "0.0000000000000000000000000000000000000117549428075736429172788299103576651332285899275899042768296311842500306496517303855853242566809058189392089843749",
        0x007fffff,
      ),
      (
        "0.000000000000000000000000000000000000011754942807573642917278829910357665133228589927589904276829631184250030649651730385585324256680905818939208984375",
        0x00800000,
      ),
      (
        "0.0000000000000000000000000000000000000117549428075736429172788299103576651332285899275899042768296311842500306496517303855853242566809058189392089843751",
        0x00800000,
      ),
      ("340282356779733661637539395458142568447.9", 0x7f7fffff),
      ("340282356779733661637539395458142568448", 0x7f800000),
      ("340282356779733661637539395458142568448.1", 0x7f800000),
    ] {
    for (prefix, sign) in [("", 0), ("-", 0x80000000)] {
      let @lib.F32(value) = wt_parse_f32(prefix + text).unwrap()
      assert_eq(value.reinterpret_as_int(), expected | sign, msg=prefix + text)
    }
  }
}

///|
test "r1 f32x4 decimal lanes round directly to binary32" {
  let mod_ = wast_to_binary_module(
    "(module (func (result v128) v128.const f32x4 1.0000000596046448 -1.0000000596046448 1.0000001788139343 1.000000059604644775390625))",
  ).unwrap()
  let bytes = @binary.encode_module(mod_.without_name_sec()).unwrap()
  // The final body instruction is fd 0c followed by the 16 lane bytes and end.
  let start = bytes.length() - 17
  assert_eq(bytes[start - 2], b'\xfd')
  assert_eq(bytes[start - 1], b'\x0c')
  let expected_lanes = [0x3f800001U, 0xbf800001U, 0x3f800001U, 0x3f800000U]
  for lane in 0..<4 {
    let expected = expected_lanes[lane]
    for offset in 0..<4 {
      assert_eq(
        bytes[start + lane * 4 + offset],
        ((expected >> (offset * 8)) & 0xffU).to_byte(),
      )
    }
  }
  @validate.validate_module(@binary.decode_module(bytes).unwrap()).unwrap()
}

///|
test "r1 f32 midpoint comparison retains distant digits and exponent spelling" {
  let above = "1.000000059604644775390625" + "0".repeat(900) + "1"
  for
    text in [
      above, "+10000000596046448e-16", "10000000596046448E-00000000000000000000000016",
    ] {
    let @lib.F32(value) = wt_parse_f32(text).unwrap()
    assert_eq(value.reinterpret_as_int(), 0x3f800001)
  }
  for
    (text, expected) in [
      ("0", 0x00000000),
      ("-0e999999999999999999999", 0x80000000),
      ("1e-999999999999999999999", 0x00000000),
      ("+inf", 0x7f800000),
      ("-inf", 0xff800000),
      ("nan", 0x7fc00000),
      ("-nan:0x1", 0xff800001),
      ("nan:0x40_0001", 0x7fc00001),
    ] {
    let @lib.F32(value) = wt_parse_f32(text).unwrap()
    assert_eq(value.reinterpret_as_int(), expected)
  }
}
